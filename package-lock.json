{
  "name": "fleet-map-rendering",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "fleet-map-rendering",
      "workspaces": [
        "simulator",
        "server"
      ],
      "engines": {
        "node": ">=24"
      }
    },
    "node_modules/@fleet/server": {
      "resolved": "server",
      "link": true
    },
    "node_modules/@fleet/simulator": {
      "resolved": "simulator",
      "link": true
    },
    "server": {
      "name": "@fleet/server",
      "version": "0.1.0"
    },
    "simulator": {
      "name": "@fleet/simulator",
      "version": "0.1.0"
    }
  }
}
